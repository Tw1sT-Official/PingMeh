<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PingMeh" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background -->
        <item name="windowSplashScreenBackground">#000000</item>
        <!-- Use transparent icon to bypass the circular crop limit, we'll draw the logo in Compose -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <item name="postSplashScreenTheme">@style/Theme.PingMeh</item>
    </style>
</resources>